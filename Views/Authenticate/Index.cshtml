<h2 class="large grid centered square-grid text-xl">
    <span>H</span>
    <span>E</span>
    <span>L</span>
    <span>L</span>
    <span>O</span>
    <span>&nbsp;</span>
    <span>W</span>
    <span>O</span>
    <span>R</span>
    <span>L</span>
    <span>D</span>
</h2>

@section scripts {
    <script>
        anime({
            targets: 'span',
            y: [
                { value: '-2.75rem', easing: 'easeOutExpo', duration: 600 },
                { value: 0, easing: 'easeOutBounce', duration: 800, delay: 100 }
            ],
            rotate: {
                value: '-1turn',
                delay: 0
            },
            delay: (el, i) => i * 50,
            easing: 'easeInOutCirc',
            loopDelay: 1000,
            loop: true
        });
    </script>
}